# Runtime
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
SHUTDOWN_TIMEOUT_MS=10000

# MongoDB. docker compose overrides this with the internal service address.
MONGO_URL=mongodb://localhost:27017/zap-runner

# Where the browser reaches the app. Must match the OAuth App's homepage and callback host.
# docker compose: http://localhost:8080   local dev (ng serve): http://localhost:4200
APP_URL=http://localhost:8080

# GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# Authorization callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# public: scopes public_repo + admin:repo_hook, Zaps work on public repositories only.
# all:    scope repo, needed for private repositories.
GITHUB_REPO_ACCESS=public

# 32 random bytes, base64. Encrypts GitHub tokens and webhook secrets at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

SESSION_TTL_HOURS=168

# Public URL GitHub delivers webhooks to. Create a channel at https://smee.io/new
# and paste its URL here; the smee service forwards deliveries to the api.
WEBHOOK_PUBLIC_URL=

# Copilot (optional). Drafts Zaps from a sentence. Each user picks a provider and saves their
# own key under Settings; these variables only set an optional server-wide fallback key.
#   gemini:    free key from https://aistudio.google.com/apikey (rate limited, no card needed)
#   openai:    key from https://platform.openai.com/api-keys (paid)
#   anthropic: key from https://console.anthropic.com/settings/keys (paid)
COPILOT_PROVIDER=gemini
COPILOT_API_KEY=
# Gemini models tried in order; the next one is used when a model is overloaded or rate limited.
COPILOT_GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
COPILOT_OPENAI_MODEL=gpt-5-mini
COPILOT_ANTHROPIC_MODEL=claude-opus-5-5
